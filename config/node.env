# ============================================================================
#  node.env — NON-SECRET runtime configuration for the runner-as-VPS stack
#  Public repo: NEVER put tokens, keys or passwords in this file.
#  Real secrets live in GitHub Actions secrets (see docs/SECURITY.md).
# ============================================================================

# ---- identity ---------------------------------------------------------------
NODE_HOSTNAME=mrphon3shop-node          # stable Funnel/MagicDNS hostname
NODE_PREFIX=mrphon3shop                 # prefix used for temp per-run hostnames
TAILNET_DNS=tail3641f4.ts.net
TS_TAG=tag:ci

# ---- ssh / funnel -----------------------------------------------------------
SSHD_PORT=22
FUNNEL_PRIMARY_MODE=tls                 # Funnel demuxes on the TLS SNI, so the door is always TLS;
                                        # the client wraps its ssh stream (docs/WINDOWS-SSH.md)
FUNNEL_PRIMARY_PORT=10000               # Funnel allows 443, 8443, 10000
FUNNEL_ALT_MODE=tls                     # second door on 8443 (used when the primary fails)
FUNNEL_ALT_PORT=8443
FUNNEL_ENABLE_ALT=always                # auto|always|never — publish both doors, clients pick one
TAILNET_SSH_FALLBACK=true               # if Funnel fails, keep tailnet-only ssh

# ---- operator access --------------------------------------------------------
NODE_USERS=mrphon user                  # operator accounts (same password as root)
ALLOW_PUBLIC_PASSWORD=false             # true = the PUBLIC Funnel door also accepts
                                        # the password (NOT recommended: internet-facing
                                        # brute force; read docs/SECURITY.md first)

# ---- node runtime -----------------------------------------------------------
PANEL_PORT=8088                         # built-in status panel (tailnet-only)
INSTALL_ROOT=${INSTALL_ROOT:-/opt/mrphon3shop}
WORK_DIR=${WORK_DIR:-/opt/mrphon3shop/work}
DATA_ROOT=${DATA_ROOT:-/opt/mrphon3shop/data}
CONFIG_ROOT=${CONFIG_ROOT:-/opt/mrphon3shop/etc}
LOG_ROOT=${LOG_ROOT:-/opt/mrphon3shop/logs}
BACKUP_ROOT=${BACKUP_ROOT:-/opt/mrphon3shop/backups}

# ---- chain / watchdog -------------------------------------------------------
JOB_MAX_MINUTES=350                     # GitHub hosted hard cap is 360
OVERLAP_SECONDS=300                     # start the successor this early
HANDOFF_WAIT_SECONDS=420                # max wait for successor readiness
LEASE_GRACE_SECONDS=180
HEARTBEAT_SECONDS=300
STANDBY_POLL_SECONDS=5
PREDECESSOR_POLL_SECONDS=5
MAX_CHAIN_DISPATCHES=4
SCHEDULE_GUARD_MINUTES=25               # keepalive cron exits if a node is fresher than this

# ---- restore / sync ---------------------------------------------------------
STATE_SYNC_SECONDS=1800                 # push state blob this often (cheap, encrypted)
SMOKE_BUDGET_SECONDS=150                # tests must finish well inside ~2-3 min
RESTORE_TIMEOUT_SECONDS=120

# ---- repos ------------------------------------------------------------------
MAIN_OWNER=mrphon3shop
MAIN_REPO=mrphon3shop.com
MEMORY_OWNER=mrphon3shop
MEMORY_REPO=mrphon3shop-data
