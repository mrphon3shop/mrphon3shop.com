#!/usr/bin/env bash
# node-marzban-creds — show the panel address and the operator credentials.
set -uo pipefail
IP="$(tailscale ip -4 2>/dev/null | head -1)"
NAME="$(hostname -s 2>/dev/null || echo node)"
USER_NAME="$(awk -F= '/^SUDO_USERNAME/{gsub(/[\" ]/,"",$2); print $2; exit}' /opt/marzban/.env 2>/dev/null)"
PW="$(sudo cat /opt/marzban/.admin-password 2>/dev/null)"
echo "panel  : http://${IP:-<tailnet-ip>}:8000/dashboard/   (also http://${NAME}:8000/dashboard/)"
echo "user   : ${USER_NAME:-admin}"
echo "pass   : ${PW:-<see /opt/marzban/.admin-password>}"
