#!/usr/bin/env bash
# ============================================================================
#  node-secret — set a GitHub Actions secret for this repository FROM the node,
#  without the value ever touching the shell history, the process list, a log or
#  this workspace's public repositories.
#
#  usage:
#    node-secret TELEGRAM_BOT_TOKEN                 # prompts (input hidden)
#    node-secret TELEGRAM_ADMIN_ID --repo data      # the memory repository
#    node-secret --list
#
#  It uses the PAT that the running node already holds
#  (/opt/mrphon3shop/etc/node.secrets.env, root only) and seals the value with
#  the repository public key (libsodium sealed box) exactly like the GitHub API
#  requires. Nothing is echoed back except the secret NAME.
# ============================================================================
set -Eeuo pipefail
OWNER="${MAIN_OWNER:-mrphon3shop}"
REPO_MAIN="${MAIN_REPO:-mrphon3shop.com}"
REPO_DATA="${MEMORY_REPO:-mrphon3shop-data}"
TARGET_REPO="$REPO_MAIN"
SECRETS_ENV=/opt/mrphon3shop/etc/node.secrets.env

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
case "${1:-}" in
  ""|-h|--help) usage 1 ;;
  --list) sed -n '1,0p' /dev/null; LIST=1 ;;
  *) LIST=0 ;;
esac

# shellcheck disable=SC1090
[ -r "$SECRETS_ENV" ] && . "$SECRETS_ENV"
PAT="${WORKFLOW_PAT:-${MEMORY_PAT:-}}"
[ -n "$PAT" ] || { echo "no PAT available on this node — run this from inside the node" >&2; exit 1; }

if [ "${LIST:-0}" = 1 ]; then
  curl -sS -H "Authorization: Bearer $PAT" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/$OWNER/$REPO_MAIN/actions/secrets" \
    | jq -r '.secrets[]?.name' | sort
  exit 0
fi

NAME="$1"; shift || true
REPO_KEY="$TARGET_REPO"
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) shift; [ "${1:-}" = data ] && REPO_KEY="$REPO_DATA" || REPO_KEY="$1" ;;
    *) echo "unknown argument: $1" >&2; exit 1 ;;
  esac
  shift || true
done
case "$NAME" in
  *[!A-Z0-9_]*) echo "secret names must be A-Z, 0-9 and _" >&2; exit 1 ;;
esac

command -v python3 >/dev/null || { echo "python3 required" >&2; exit 1; }
if ! python3 -c 'import nacl.public' 2>/dev/null; then
  echo "installing python3-nacl (one-time, small)…" >&2
  sudo apt-get install -y -qq python3-nacl >/dev/null 2>&1 || {
    echo "could not install python3-nacl; try: sudo apt-get install python3-nacl" >&2; exit 1; }
fi

# --- the value: hidden prompt, or a file you already have -------------------
if [ -n "${SECRET_VALUE_FILE:-}" ]; then
  [ -r "$SECRET_VALUE_FILE" ] || { echo "cannot read $SECRET_VALUE_FILE" >&2; exit 1; }
else
  printf 'value for %s (input hidden): ' "$NAME" >&2
  IFS= read -rs VALUE; echo >&2
  printf 'repeat it: ' >&2
  IFS= read -rs VALUE2; echo >&2
  [ "$VALUE" = "$VALUE2" ] || { echo "the two values differ — nothing was changed" >&2; exit 1; }
  [ -n "$VALUE" ] || { echo "empty value — nothing was changed" >&2; exit 1; }
  export SECRET_VALUE="$VALUE"; unset VALUE VALUE2
fi

KEY_JSON="$(curl -sS -H "Authorization: Bearer $PAT" -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/$OWNER/$REPO_KEY/actions/secrets/public-key")"
KEY_ID="$(jq -r '.key_id' <<<"$KEY_JSON")"; KEY_B64="$(jq -r '.key' <<<"$KEY_JSON")"
[ -n "$KEY_ID" ] && [ "$KEY_ID" != null ] || { echo "cannot read the repository public key (PAT scope?)" >&2; exit 1; }

BODY="$(mktemp)"; chmod 600 "$BODY"
KEY_ID="$KEY_ID" KEY_B64="$KEY_B64" python3 - "$BODY" <<'PY'
import os, sys, base64, json, pathlib
from nacl import public, encoding
value = os.environ["SECRET_VALUE"].encode()
pk = public.PublicKey(os.environ["KEY_B64"].encode(), encoding.Base64Encoder())
sealed = public.SealedBox(pk).encrypt(value)
pathlib.Path(sys.argv[1]).write_text(json.dumps({
    "encrypted_value": base64.b64encode(sealed).decode(),
    "key_id": os.environ["KEY_ID"],
}))
PY
CODE="$(curl -sS -o /tmp/node-secret.out -w '%{http_code}' -X PUT \
  -H "Authorization: Bearer $PAT" -H "Accept: application/vnd.github+json" \
  -H "Content-Type: application/json" --data-binary "@$BODY" \
  "https://api.github.com/repos/$OWNER/$REPO_KEY/actions/secrets/$NAME")"
rm -f "$BODY" /tmp/node-secret.out
unset SECRET_VALUE

if [ "$CODE" = 201 ] || [ "$CODE" = 204 ]; then
  echo "set $NAME on $OWNER/$REPO_KEY (value never printed)"
else
  echo "GitHub returned HTTP $CODE — the secret was not stored" >&2; exit 1
fi
